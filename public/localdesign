<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>SafeTrip</title>
<style>
:root{
  --ink:#2d1d20; --muted:#75676a; --line:#eadbd6; --blue:#d97468;
  --blue-dark:#bd5f55; --red:#c93f3f; --green:#668b70; --yellow:#c99b62;
  --panel:#fffaf7; --map:#eee7e3; --cream:#fff8f4; --blush:#f6e5df; --coral:#d97468;
}
*{box-sizing:border-box}
body{margin:0;background:#f3e7e2;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif;color:var(--ink);min-height:100vh;display:grid;place-items:center;padding:22px}
button,input{font:inherit}
.phone{width:min(390px,100%);height:844px;background:var(--cream);border:9px solid #12161d;border-radius:40px;overflow:hidden;position:relative;box-shadow:0 20px 60px rgba(12,20,30,.18)}
.status{position:absolute;z-index:40;top:0;left:0;right:0;height:31px;padding:8px 18px 0;display:flex;justify-content:space-between;font-size:12px;font-weight:700;color:#17202b;pointer-events:none}
.app{height:100%;position:relative}
.screen{display:none;position:absolute;inset:0;background:var(--cream);overflow:auto;padding-top:31px}.screen.active{display:block}

/* map home */
#home{overflow:hidden;background:#e8edf0}
.map-home{position:absolute;inset:0;background:
 linear-gradient(27deg,transparent 44%,#fdfdfd 44.5% 49%,#d8dde1 49.5% 50.2%,#fdfdfd 50.7% 55%,transparent 55.5%),
 linear-gradient(108deg,transparent 42%,#fff 42.5% 47.5%,#d8dde1 48% 48.6%,#fff 49.1% 54%,transparent 54.5%),
 linear-gradient(6deg,transparent 61%,#fff 61.4% 65%,#d8dde1 65.4% 66%,#fff 66.4% 70%,transparent 70.5%),
 radial-gradient(circle at 15% 24%,#cfe1c6 0 13%,transparent 13.5%),
 radial-gradient(circle at 84% 18%,#d8e6cf 0 14%,transparent 14.5%),
 radial-gradient(circle at 78% 71%,#c7dfc7 0 16%,transparent 16.5%),
 radial-gradient(circle at 20% 79%,#d4e5ca 0 12%,transparent 12.5%),
 #e7ecef;
}
.block{position:absolute;background:#d9dde0;border-radius:10px;opacity:.72}.b1{left:15px;top:180px;width:80px;height:54px}.b2{left:264px;top:255px;width:92px;height:70px}.b3{left:38px;top:430px;width:110px;height:82px}.b4{left:220px;top:525px;width:96px;height:58px}.b5{left:112px;top:92px;width:72px;height:40px}
.road-name{position:absolute;font-size:10px;color:#7e878f;font-weight:600;letter-spacing:.1px}.rn1{left:100px;top:265px;transform:rotate(-25deg)}.rn2{left:233px;top:396px;transform:rotate(18deg)}.rn3{left:108px;top:598px;transform:rotate(-6deg)}
.searchbar{position:absolute;z-index:10;top:47px;left:14px;right:14px;height:54px;border-radius:18px;background:#fffaf7;box-shadow:0 5px 18px rgba(19,30,40,.16);display:flex;align-items:center;padding:0 10px 0 15px;gap:10px}
.searchbar .logo{width:34px;height:34px;border-radius:50%;overflow:hidden;display:grid;place-items:center;background:#f6e5df;border:1px solid #e5c9c1;flex:0 0 auto}.searchbar .logo img{width:100%;height:100%;object-fit:cover;display:block}
.searchbar input{border:0;outline:0;flex:1;font-size:15px;background:transparent;color:var(--ink)}
.searchbar input::placeholder{color:#7d8792}.profile{width:35px;height:35px;border:0;border-radius:50%;background:#eef2f5;font-weight:800;color:#566270;cursor:pointer}
.float-btn{position:absolute;z-index:12;width:48px;height:48px;border:0;border-radius:50%;background:#fff;box-shadow:0 4px 15px rgba(20,29,38,.17);display:grid;place-items:center;font-size:20px;cursor:pointer}.layers{right:14px;top:119px}.locate{right:14px;bottom:212px}.report{left:14px;bottom:212px;background:#fff1f2;color:#d93845;font-size:19px}
.pin{position:absolute;z-index:4;width:35px;height:35px;border-radius:50% 50% 50% 8px;transform:rotate(-45deg);display:grid;place-items:center;color:#fff;box-shadow:0 3px 9px rgba(0,0,0,.2);border:3px solid #fff}.pin span{transform:rotate(45deg);font-size:13px;font-weight:900}.hospital{left:82px;top:220px;background:var(--red)}.police{right:76px;top:342px;background:var(--blue)}.safe{left:215px;top:508px;background:var(--green)}
.me{position:absolute;z-index:6;width:28px;height:28px;border-radius:50%;background:var(--blue);border:4px solid #fff;box-shadow:0 0 0 7px rgba(31,143,255,.15);left:179px;top:373px}.me:after{content:"";position:absolute;left:6px;top:-12px;border-left:5px solid transparent;border-right:5px solid transparent;border-bottom:13px solid var(--blue)}
.alert{position:absolute;z-index:7;left:117px;top:294px;background:#fff;border:1px solid #e0e5e9;border-radius:12px;padding:7px 10px;font-size:11px;font-weight:700;box-shadow:0 3px 12px rgba(0,0,0,.09)}
.trip-sheet{position:absolute;z-index:15;left:0;right:0;bottom:0;background:#fffaf7;border-radius:24px 24px 0 0;box-shadow:0 -7px 22px rgba(23,31,39,.14);padding:10px 16px 16px}
.handle{width:40px;height:4px;border-radius:999px;background:#d9dde1;margin:0 auto 12px}.sheet-title{font-size:19px;font-weight:800;margin-bottom:5px}.sheet-sub{font-size:13px;color:var(--muted);margin-bottom:13px}.destination{height:52px;border:1px solid #e3e7eb;border-radius:15px;display:flex;align-items:center;padding:0 12px;gap:10px;cursor:pointer}.destination .dot{width:10px;height:10px;border-radius:50%;background:var(--blue)}.destination strong{font-size:14px;display:block}.destination small{color:var(--muted);font-size:11px}.start-row{display:grid;grid-template-columns:1fr 54px;gap:9px;margin-top:10px}.start{border:0;border-radius:15px;background:var(--blue);color:white;font-weight:800;font-size:15px;cursor:pointer}.sos-mini{border:0;border-radius:15px;background:#fff0f1;color:#e33d49;font-weight:900;font-size:13px;cursor:pointer}

/* secondary screens */
.topbar{height:58px;background:#fffaf7;border-bottom:1px solid var(--line);display:flex;align-items:center;gap:12px;padding:0 15px;position:sticky;top:0;z-index:4}.back{width:36px;height:36px;border:0;border-radius:50%;background:#f1f3f5;cursor:pointer}.topbar h1{font-size:18px;margin:0}.topbar-brand{margin-left:auto;width:30px;height:30px;border-radius:50%;overflow:hidden;border:1px solid #ead0c8;background:#f6e5df}.topbar-brand img{width:100%;height:100%;object-fit:cover;display:block}.content{padding:16px}.card{background:#fffdfb;border:1px solid var(--line);border-radius:18px;padding:14px}.section-label{font-size:12px;color:#9c625d;font-weight:800;text-transform:uppercase;letter-spacing:.6px;margin:17px 2px 8px}.emergency-box{text-align:center;padding:26px 16px}.sos-circle{width:185px;height:185px;margin:14px auto 20px;border-radius:50%;border:11px solid #ffd9dc;background:var(--red);display:grid;place-items:center;color:#fff;box-shadow:0 12px 28px rgba(255,77,86,.27);cursor:pointer}.sos-circle b{font-size:43px;display:block}.sos-circle small{font-size:11px;font-weight:800}.action{width:100%;border:1px solid var(--line);background:#fff;border-radius:15px;padding:14px;text-align:left;font-weight:750;margin-top:9px;cursor:pointer}.person{display:flex;align-items:center;gap:12px;padding:12px 0;border-bottom:1px solid var(--line)}.person:last-child{border-bottom:0}.avatar{width:42px;height:42px;border-radius:50%;background:#eaf4ff;color:#157ddd;display:grid;place-items:center;font-weight:900}.meta{flex:1}.meta b{display:block;font-size:14px}.meta small{color:var(--muted)}.tip{display:flex;gap:12px;padding:13px 0;border-bottom:1px solid var(--line)}.tip:last-child{border-bottom:0}.tip-icon{width:38px;height:38px;border-radius:12px;background:#eef4f8;display:grid;place-items:center}.tip b{font-size:14px}.tip p{margin:3px 0 0;color:var(--muted);font-size:12px;line-height:1.4}
.bottom-nav{position:absolute;z-index:25;left:10px;right:10px;bottom:10px;height:68px;background:#fffaf7;border-radius:22px;box-shadow:0 6px 22px rgba(16,27,37,.17);display:grid;grid-template-columns:1fr 1fr 82px 1fr 1fr;align-items:end;padding:6px}.nav{height:56px;border:0;background:transparent;border-radius:15px;color:#7a8590;font-size:10px;font-weight:750;cursor:pointer}.nav span{display:block;font-size:19px;margin-bottom:2px}.nav.active{background:#f7e3de;color:var(--blue-dark)}.sos-nav-wrap{display:grid;place-items:center;height:62px}.sos-nav{width:66px;height:66px;border-radius:50%;border:6px solid #fffaf7;background:#c83d3d;color:#fff;font-size:13px;font-weight:900;letter-spacing:.4px;box-shadow:0 5px 17px rgba(153,45,45,.28);transform:translateY(-12px);cursor:pointer;user-select:none;-webkit-user-select:none;touch-action:none}.sos-nav:active{transform:translateY(-12px) scale(.97)}
.toast{position:absolute;z-index:50;left:18px;right:18px;bottom:88px;background:#17202a;color:#fff;border-radius:13px;padding:12px 14px;font-size:13px;opacity:0;transform:translateY(8px);transition:.18s;pointer-events:none}.toast.show{opacity:1;transform:none}

/* route + hotline features */
.route-hero{background:#fffaf7;border-bottom:1px solid var(--line);padding:16px}
.route-points{display:grid;grid-template-columns:20px 1fr;gap:10px;align-items:start}
.route-line{display:flex;flex-direction:column;align-items:center;padding-top:4px}.route-dot{width:10px;height:10px;border-radius:50%;background:var(--blue)}.route-dot.end{background:var(--red)}.route-stem{width:2px;height:33px;background:#cbd4dc;margin:4px 0}
.route-input{border:0;background:#f4f6f8;border-radius:12px;padding:11px 12px;font-size:13px;font-weight:700}.route-input+ .route-input{margin-top:8px}
.estimate{margin-top:14px;background:#f9ece7;border:1px solid #ecd2ca;border-radius:16px;padding:13px}.estimate-top{display:flex;align-items:end;justify-content:space-between;gap:12px}.estimate-time{font-size:27px;font-weight:850;letter-spacing:-.7px}.estimate-label{font-size:12px;color:var(--muted)}
.safety-score{display:flex;align-items:center;gap:8px;margin-top:10px}.score-pill{background:#e8f7ef;color:#178a53;font-size:12px;font-weight:850;padding:6px 9px;border-radius:999px}.score-note{font-size:11px;color:var(--muted)}
.route-choice{display:flex;gap:11px;align-items:flex-start;padding:14px 0;border-bottom:1px solid var(--line);cursor:pointer}.route-choice:last-child{border-bottom:0}.route-icon{width:38px;height:38px;border-radius:12px;background:#f6e2dc;color:var(--blue-dark);display:grid;place-items:center;font-weight:900}.route-main{flex:1}.route-main b{display:block;font-size:14px}.route-main small{display:block;color:var(--muted);font-size:11px;margin-top:3px;line-height:1.35}.route-stat{text-align:right}.route-stat b{font-size:13px}.route-stat small{display:block;color:var(--muted);font-size:10px;margin-top:3px}
.hotline{display:flex;gap:12px;align-items:center;padding:13px 0;border-bottom:1px solid var(--line)}.hotline:last-child{border-bottom:0}.hotline-icon{width:42px;height:42px;border-radius:13px;background:#f2f5f7;display:grid;place-items:center;font-size:18px}.hotline-info{flex:1}.hotline-info b{display:block;font-size:14px}.hotline-info small{display:block;color:var(--muted);font-size:11px;margin-top:2px}.call-btn{border:0;background:#eaf6ef;color:#18824f;font-weight:850;border-radius:11px;padding:9px 11px;cursor:pointer}
.quick-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.quick-card{border:1px solid var(--line);background:#fffdfb;border-radius:16px;padding:13px;min-height:100px;cursor:pointer;text-align:left}.quick-card span{font-size:22px}.quick-card b{display:block;font-size:13px;margin-top:9px}.quick-card small{display:block;color:var(--muted);font-size:10px;margin-top:3px;line-height:1.35}.profile-head{background:#f8e8e2;padding:22px 18px 16px;border-bottom:1px solid var(--line);position:relative}.profile-brand{position:absolute;right:18px;top:18px;width:54px;height:54px;border-radius:50%;overflow:hidden;background:#f6e5df;border:1px solid #e3c5bd;box-shadow:0 4px 12px rgba(70,40,40,.08)}.profile-brand img{width:100%;height:100%;object-fit:cover;display:block}.profile-row{display:flex;align-items:center;gap:13px}.profile-avatar{width:58px;height:58px;border-radius:50%;background:#f2d2ca;color:#9f4e47;display:grid;place-items:center;font-size:22px;font-weight:900}.profile-copy h2{font-size:20px;margin:0 0 3px}.profile-copy p{font-size:12px;color:var(--muted);margin:0}.warning{background:#fbe9e5;border:1px solid #edc8c0;border-radius:15px;padding:12px 13px;color:#b62c34;font-size:12px;line-height:1.45}.setting{display:flex;align-items:center;gap:12px;padding:14px 0;border-bottom:1px solid var(--line)}.setting:last-child{border-bottom:0}.setting-icon{width:38px;height:38px;border-radius:12px;background:#f5e8e3;display:grid;place-items:center}.setting-copy{flex:1}.setting-copy b{display:block;font-size:14px}.setting-copy small{display:block;color:var(--muted);font-size:11px;margin-top:2px}.chev{color:#9aa4ae;font-size:20px}.modal{position:absolute;z-index:80;inset:0;background:rgba(15,20,25,.45);display:none;align-items:flex-end;padding:18px}.modal.show{display:flex}.modal-card{width:100%;background:#fff;border-radius:22px;padding:18px}.modal-card h3{margin:0 0 6px;font-size:19px}.modal-card p{margin:0 0 14px;color:var(--muted);font-size:13px;line-height:1.4}.modal-actions{display:grid;grid-template-columns:1fr 1fr;gap:9px}.modal-actions button{border:0;border-radius:14px;padding:13px;font-weight:800;cursor:pointer}.cancel{background:#eef1f4;color:#333}.call911{background:#e53e45;color:#fff}
</style>
</head>
<body>
<div class="phone">
  <div class="status"><span>9:41</span><span>●●● ◒</span></div>
  <div class="app">
    <main id="home" class="screen active">
      <div class="map-home">
        <div class="block b1"></div><div class="block b2"></div><div class="block b3"></div><div class="block b4"></div><div class="block b5"></div>
        <span class="road-name rn1">Riverside Ave</span><span class="road-name rn2">5th Street</span><span class="road-name rn3">Market Road</span>
        <div class="searchbar"><div class="logo" title="Safety for Her Empowerment"><img src="data:image/png;base64," alt="S.H.E. logo"></div><input placeholder="Where are you going?" /><button class="profile" onclick="go('profile')">M</button></div>
        <button class="float-btn layers" onclick="notify('Map filters: police, hospitals, safe places')">◫</button>
        <button class="float-btn report" onclick="notify('Report menu opened')">⚠</button>
        <button class="float-btn locate" onclick="notify('Centered on your location')">⌖</button>
        <div class="pin hospital"><span>H</span></div><div class="pin police"><span>P</span></div><div class="pin safe"><span>✓</span></div>
        <div class="me"></div><div class="alert">Busy area • 4 recent reports</div>
        <section class="trip-sheet">
          <div class="handle"></div>
          <div class="sheet-title">Start a safe trip</div>
          <div class="sheet-sub">Route with nearby help points and share your ETA.</div>
          <div class="destination" onclick="go('routes')"><span class="dot"></span><div><strong>Choose destination</strong><small>Compare fastest and safest routes</small></div></div>
          <div class="start-row"><button class="start" onclick="go('routes')">See safe routes</button><button class="sos-mini" onclick="go('sos')">SOS</button></div>
        </section>
      </div>
    </main>

    <main id="sos" class="screen">
      <div class="topbar"><button class="back" onclick="go('home')">‹</button><h1>Emergency & help</h1><div class="topbar-brand"><img src="data:image/png;base64," alt="S.H.E. logo"></div></div>
      <div class="content">
        <div class="emergency-box" style="padding:8px 0 4px"><p style="color:var(--muted);font-size:13px;margin:0">For immediate danger, press and hold SOS in the bottom bar.</p><div class="sos-circle" onclick="show911Confirm()"><div><b>911</b><small>EMERGENCY CALL</small></div></div></div>
        <div class="section-label">Quick help</div>
        <div class="quick-grid"><button class="quick-card" onclick="notify('Emergency text prepared with your live location')"><span>TXT</span><b>Text trusted contacts</b><small>Send your location and an emergency message.</small></button><button class="quick-card" onclick="notify('Live location sharing started')"><span>LOC</span><b>Share location</b><small>Share your exact position with trusted contacts.</small></button></div>
        <div class="section-label">Hotlines</div><div class="card">
          <div class="hotline"><div class="hotline-icon">PD</div><div class="hotline-info"><b>Police non-emergency</b><small>For situations that are not an immediate danger.</small></div><button class="call-btn" onclick="notify('Call action opened')">Call</button></div>
          <div class="hotline"><div class="hotline-icon">MED</div><div class="hotline-info"><b>Medical help line</b><small>Health guidance and nearby care.</small></div><button class="call-btn" onclick="notify('Call action opened')">Call</button></div>
          <div class="hotline"><div class="hotline-icon">SAFE</div><div class="hotline-info"><b>Local safety line</b><small>Your saved campus or community safety resource.</small></div><button class="call-btn" onclick="notify('Call action opened')">Call</button></div>
        </div>
        <div class="section-label">Safety tips</div><div class="card">
          <div class="tip"><div class="tip-icon">VIEW</div><div><b>Stay aware</b><p>Keep audio low enough to hear what is happening around you.</p></div></div>
          <div class="tip"><div class="tip-icon">SHARE</div><div><b>Share your route</b><p>Let someone you trust know your destination and ETA.</p></div></div>
          <div class="tip"><div class="tip-icon">ROUTE</div><div><b>Choose active routes</b><p>Prefer well-lit streets with open businesses and foot traffic.</p></div></div>
        </div>
        <div style="height:84px"></div>
      </div>
    </main>

    <main id="routes" class="screen">
      <div class="topbar"><button class="back" onclick="go('home')">‹</button><h1>Safest trip</h1></div>
      <div class="route-hero">
        <div class="route-points"><div class="route-line"><span class="route-dot"></span><span class="route-stem"></span><span class="route-dot end"></span></div><div><div class="route-input">Current location</div><div class="route-input">Union Square</div></div></div>
        <div class="estimate"><div class="estimate-top"><div><div class="estimate-label">Safest route estimate</div><div class="estimate-time">18 min</div></div><div style="text-align:right"><b style="font-size:14px">1.4 mi</b><div class="estimate-label">arrival 5:13 PM</div></div></div><div class="safety-score"><span class="score-pill">Safety 92</span><span class="score-note">Well-lit streets • 2 help points nearby</span></div></div>
      </div>
      <div class="content"><div class="section-label">Choose a route</div><div class="card">
        <div class="route-choice" onclick="notify('Safest route selected')"><div class="route-icon">✓</div><div class="route-main"><b>Safest route</b><small>More lighting, open businesses and a police station along the way.</small></div><div class="route-stat"><b>18 min</b><small>Safety 92</small></div></div>
        <div class="route-choice" onclick="notify('Fastest route selected')"><div class="route-icon">↗</div><div class="route-main"><b>Fastest route</b><small>4 minutes quicker, but passes one area with recent reports.</small></div><div class="route-stat"><b>14 min</b><small>Safety 74</small></div></div>
        <div class="route-choice" onclick="notify('Transit route selected')"><div class="route-icon">▣</div><div class="route-main"><b>Public transit</b><small>Bus + 6 minute walk. Busy stops and good lighting.</small></div><div class="route-stat"><b>23 min</b><small>Safety 88</small></div></div>
      </div><button class="action" style="background:var(--blue);color:#fff;border:0;text-align:center" onclick="notify('Trip started • ETA shared with trusted contacts')">Start safest trip</button></div>
    </main>

    <main id="hotlines" class="screen">
      <div class="topbar"><button class="back" onclick="go('home')">‹</button><h1>Hotlines</h1></div>
      <div class="content"><div class="section-label">Quick help</div><div class="quick-grid"><button class="quick-card" onclick="go('sos')"><span>SOS</span><b>Emergency SOS</b><small>Call, text and share your location fast.</small></button><button class="quick-card" onclick="go('contacts')"><span>PEOPLE</span><b>Trusted contacts</b><small>Choose who receives your trip alerts.</small></button></div>
      <div class="section-label">Support lines</div><div class="card">
        <div class="hotline"><div class="hotline-icon">PD</div><div class="hotline-info"><b>Police non-emergency</b><small>For situations that are not an immediate danger.</small></div><button class="call-btn" onclick="notify('Call action opened')">Call</button></div>
        <div class="hotline"><div class="hotline-icon">MED</div><div class="hotline-info"><b>Medical help line</b><small>Health guidance and nearby care information.</small></div><button class="call-btn" onclick="notify('Call action opened')">Call</button></div>
        <div class="hotline"><div class="hotline-icon">SAFE</div><div class="hotline-info"><b>Campus / local safety</b><small>Connect to a saved local safety resource.</small></div><button class="call-btn" onclick="notify('Call action opened')">Call</button></div>
      </div><p style="font-size:11px;color:var(--muted);line-height:1.45;margin:12px 3px">Numbers shown in a real app would be based on your location and verified local resources.</p></div>
    </main>

    <main id="tips" class="screen">
      <div class="topbar"><button class="back" onclick="go('home')">‹</button><h1>Safety tips</h1></div>
      <div class="content">
        <div style="background:#f6e5df;border:1px solid #ead0c8;border-radius:20px;padding:18px;margin-bottom:14px">
          <div style="font-family:Georgia,serif;font-size:25px;font-weight:700;line-height:1.05;color:#2d1d20">Feel prepared, not afraid.</div>
          <p style="margin:8px 0 0;color:var(--muted);font-size:12px;line-height:1.5">Simple habits for walking, rides, nights out and unexpected situations.</p>
        </div>
        <div class="section-label">Everyday safety</div><div class="card">
          <div class="tip"><div class="tip-icon">VIEW</div><div><b>Stay aware of your surroundings</b><p>Keep headphones low, notice exits and trust changes in your environment.</p></div></div>
          <div class="tip"><div class="tip-icon">LOC</div><div><b>Share your trip</b><p>Send your route and ETA to a trusted contact when traveling alone or late.</p></div></div>
          <div class="tip"><div class="tip-icon">LIGHT</div><div><b>Choose active, well-lit routes</b><p>Prefer streets with open businesses, lighting and regular foot traffic.</p></div></div>
        </div>
        <div class="section-label">If something feels wrong</div><div class="card">
          <div class="tip"><div class="tip-icon">OPEN</div><div><b>Move toward people and open places</b><p>Enter a staffed business, hotel lobby, transit station or other public place.</p></div></div>
          <div class="tip"><div class="tip-icon">CALL</div><div><b>Use SOS when you need help</b><p>Tap SOS for emergency resources. Press and hold the bottom SOS button to open the 911 call flow.</p></div></div>
          <div class="tip"><div class="tip-icon">VOICE</div><div><b>Be clear and direct</b><p>If safe to do so, tell someone to stop, create distance and call for help.</p></div></div>
        </div>
        <div class="section-label">Before you go</div><div class="card">
          <div class="tip"><div class="tip-icon">BAT</div><div><b>Charge your phone</b><p>Keep enough battery for navigation, calls and location sharing.</p></div></div>
          <div class="tip"><div class="tip-icon">PEOPLE</div><div><b>Set trusted contacts</b><p>Choose who should receive SOS alerts and safe-trip updates in Profile.</p></div></div>
        </div>
        <div style="height:92px"></div>
      </div>
    </main>

    <main id="profile" class="screen">
      <div class="topbar"><button class="back" onclick="go('home')">‹</button><h1>Profile</h1></div>
      <div class="profile-head"><div class="profile-brand"><img src="data:image/png;base64," alt="Safety for Her Empowerment logo"></div><div class="profile-row"><div class="profile-avatar">M</div><div class="profile-copy"><h2>My safety profile</h2><p>Emergency info, trusted contacts and app settings</p></div></div></div>
      <div class="content">
        <div class="warning">NOTE Emergency information is stored on this device. If you choose to sync it online, review the privacy settings first.</div>
        <div class="section-label">Emergency card</div><div class="card">
          <div class="setting" onclick="notify('Emergency card opened')"><div class="setting-icon">ID</div><div class="setting-copy"><b>Emergency card</b><small>Name, allergies, medical notes and emergency details</small></div><div class="chev">›</div></div>
          <div class="setting" onclick="notify('Passcode settings opened')"><div class="setting-icon">LOCK</div><div class="setting-copy"><b>Lock emergency info</b><small>Require a passcode before editing sensitive details</small></div><div class="chev">›</div></div>
        </div>
        <div class="section-label">People & alerts</div><div class="card">
          <div class="setting" onclick="go('contacts')"><div class="setting-icon">PEOPLE</div><div class="setting-copy"><b>Trusted contacts</b><small>Choose who gets SOS alerts and trip updates</small></div><div class="chev">›</div></div>
          <div class="setting" onclick="notify('Notification settings opened')"><div class="setting-icon">ALERT</div><div class="setting-copy"><b>Notification settings</b><small>Trip check-ins, arrival alerts and safety notices</small></div><div class="chev">›</div></div>
        </div>
        <div class="section-label">Privacy & appearance</div><div class="card">
          <div class="setting" onclick="notify('Permissions & privacy opened')"><div class="setting-icon">SAFE</div><div class="setting-copy"><b>Permissions & privacy</b><small>Location, contacts and data-sharing controls</small></div><div class="chev">›</div></div>
          <div class="setting" onclick="document.body.classList.toggle('dark'); notify('Appearance changed')"><div class="setting-icon">◐</div><div class="setting-copy"><b>Appearance</b><small>Light / dark mode</small></div><div class="chev">›</div></div>
        </div><div style="height:84px"></div>
      </div>
    </main>

    <main id="contacts" class="screen">
      <div class="topbar"><button class="back" onclick="go('profile')">‹</button><h1>Trusted contacts</h1></div>
      <div class="content"><div class="section-label">Trip alerts</div><div class="card"><div class="person"><div class="avatar">M</div><div class="meta"><b>Maya</b><small>Trip updates + SOS</small></div><span>✓</span></div><div class="person"><div class="avatar">M</div><div class="meta"><b>Mom</b><small>Trip updates + SOS</small></div><span>✓</span></div><div class="person"><div class="avatar">J</div><div class="meta"><b>Jordan</b><small>SOS only</small></div><span>✓</span></div></div><button class="action" onclick="notify('Add contact opened')">＋ Add trusted contact</button></div>
    </main>

    <nav class="bottom-nav">
      <button class="nav active" data-target="home" onclick="go('home')"><span>⌖</span>Map</button>
      <button class="nav" data-target="routes" onclick="go('routes')"><span>↗</span>Trips</button>
      <div class="sos-nav-wrap"><button id="sosNav" class="sos-nav" aria-label="SOS. Tap for emergency page or hold to call 911">SOS</button></div>
      <button class="nav" data-target="tips" onclick="go('tips')"><span>✦</span>Tips</button>
      <button class="nav" data-target="profile" onclick="go('profile')"><span>●</span>Profile</button>
    </nav>
  </div>
  <div id="callModal" class="modal"><div class="modal-card"><h3>Call 911?</h3><p>This prototype will not place a call automatically. On a real device, this action would open the emergency call flow.</p><div class="modal-actions"><button class="cancel" onclick="hide911Confirm()">Cancel</button><button class="call911" onclick="notify('911 call simulated');hide911Confirm()">Call 911</button></div></div></div>
  <div id="toast" class="toast"></div>
</div>
<script>
function go(id){
  document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));
  document.getElementById(id).classList.add('active');
  document.querySelectorAll('.nav').forEach(n=>n.classList.toggle('active',n.dataset.target===id));
}
function show911Confirm(){document.getElementById('callModal').classList.add('show')}
function hide911Confirm(){document.getElementById('callModal').classList.remove('show')}
const sosNav=document.getElementById('sosNav');
let holdTimer, held=false;
function startHold(e){e.preventDefault();held=false;holdTimer=setTimeout(()=>{held=true;show911Confirm()},1100)}
function endHold(e){clearTimeout(holdTimer);if(!held)go('sos')}
sosNav.addEventListener('pointerdown',startHold);
sosNav.addEventListener('pointerup',endHold);
sosNav.addEventListener('pointercancel',()=>clearTimeout(holdTimer));
sosNav.addEventListener('pointerleave',()=>clearTimeout(holdTimer));
let timer;
function notify(msg){
  const t=document.getElementById('toast');t.textContent=msg;t.classList.add('show');
  clearTimeout(timer);timer=setTimeout(()=>t.classList.remove('show'),2200)
}
</script>
</body>
</html>
